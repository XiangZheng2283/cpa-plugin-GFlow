{
  "manifest_version": 3,
  "name": "GFlow 登录助手",
  "version": "1.3.4.1",
  "description": "自动提取 Google Flow 登录态并同步至 EasyCPA GFlow 插件系统",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "https://flow.google.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://github.com/daodeqing/cpa-plugin-GFlow/tree/main/browser-extension",
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "flow-session.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
